AUTHELIA_BACKUP_ROOT=/opt/docker
RESTIC_REPOSITORY=sftp:tiffy:/data/zeus/restic/authelia
RESTIC_TAG=authelia
BACKUP_PATHS="/source/1 /source/2/authelia/postgres /source/3/portainer-compose-unpacker/stacks/authelia/authelia-docker/config /source/3/portainer-compose-unpacker/stacks/authelia/authelia-docker/docker-compose.yml /source/3/rootca/root-ca.cert.pem"
RESTIC_CONTAINER_BACKUP_SOURCE_1=/opt/docker/authelia
RESTIC_CONTAINER_BACKUP_SOURCE_2=/srv/backup/zeus
RESTIC_CONTAINER_BACKUP_SOURCE_3=${AUTHELIA_BACKUP_ROOT}
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

SYSTEMD_ON_CALENDAR="*-*-* 00:25:00"
SYSTEMD_RANDOMIZED_DELAY_SEC=5m
SYSTEMD_ACCURACY_SEC=1m

AUTHELIA_STOP_CONTAINERS="authelia"
AUTHELIA_PG_CONTAINER=authelia-postgresql-1
AUTHELIA_PG_DB_NAME=authelia
AUTHELIA_PG_DUMP_FILE=/srv/backup/zeus/authelia/postgres/latest.dump

PRE_BACKUP_COMMAND='./scripts/restic-authelia-pre-backup.sh'
POST_BACKUP_COMMAND='echo "==> Starting Authelia container(s): ${AUTHELIA_STOP_CONTAINERS}"; docker start ${AUTHELIA_STOP_CONTAINERS}; echo "==> Authelia container(s) started: ${AUTHELIA_STOP_CONTAINERS}"'
