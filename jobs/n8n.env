RESTIC_REPOSITORY=sftp:tiffy:/data/zeus/restic/n8n
RESTIC_TAG=n8n
BACKUP_PATHS="/source/1/n8n/db /source/1/n8n/meta"
RESTIC_CONTAINER_BACKUP_SOURCE_1=/srv/backup/zeus
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

SYSTEMD_ON_CALENDAR="*-*-* 03:45:00"
SYSTEMD_RANDOMIZED_DELAY_SEC=5m
SYSTEMD_ACCURACY_SEC=1m

N8N_PG_CONTAINER=n8n-postgres-1
N8N_PG_DUMP_FILE=/srv/backup/zeus/n8n/db/latest.sql
N8N_CONTAINER=n8n-n8n-1
N8N_CONFIG_FILE=/home/node/.n8n/config
N8N_KEY_FILE=/srv/backup/zeus/n8n/meta/n8n_encryption_key.env

PRE_BACKUP_COMMAND='"${REPO_DIR}/scripts/restic-n8n-pre-backup.sh"'
